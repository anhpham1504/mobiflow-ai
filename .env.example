# Copy to .env, generate secrets locally, and never commit the result.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Optional host port overrides for an isolated Compose project; loopback binding remains.
POSTGRES_PORT=5432
WEB_PORT=3000
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_LOCALLY
POSTGRES_APP_PASSWORD=CHANGE_ME_GENERATE_SEPARATELY
DATABASE_URL=postgresql://mobiflow_app:CHANGE_ME@localhost:5432/mobiflow
MIGRATION_DATABASE_URL=postgresql://mobiflow_owner:CHANGE_ME@localhost:5432/mobiflow
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET
JWT_ISSUER=mobiflow-ai
JWT_AUDIENCE=mobiflow-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=604800
# false is accepted only with a loopback HTTP WEB_ORIGIN for the explicit local demo.
AUTH_COOKIE_SECURE=false
DEMO_MODE=true
# Keep candidate evidence separate; historical milestone evidence stays intact.
DEMO_EVIDENCE_ROOT=artifacts/v1.4.2/evidence
AI_GENERATION_PROVIDER=deepseek
RAG_RETRIEVAL_MODE=lexical
# Billable egress remains off until the owner separately approves the canary.
AI_LIVE_CALLS_ENABLED=false
# Backend only. Leave empty while live calls are disabled; never use NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BUDGET_USD=0.25
DEEPSEEK_MAX_CALLS_PER_PROCESS=3
DEEPSEEK_MAX_REQUESTS_PER_MINUTE=2
DEEPSEEK_MAX_CONCURRENT_REQUESTS=1
# Verified against the official pricing page on 2026-10-23; re-verify before live use.
DEEPSEEK_PRICE_CACHE_HIT_INPUT_PER_MILLION_USD=0.006
DEEPSEEK_PRICE_CACHE_MISS_INPUT_PER_MILLION_USD=0.30
DEEPSEEK_PRICE_OUTPUT_PER_MILLION_USD=1.20
DEEPSEEK_PRICING_EFFECTIVE_DATE=2026-10-23
AI_AUTO_ANALYZE=true
AI_ATTEMPT_TIMEOUT_MS=120000
AI_RUN_TIMEOUT_MS=300000
AI_GENERATION_MAX_ATTEMPTS=2
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=1200
# Lexical RAG needs PostgreSQL only. Ollama values below are rollback settings and
# are ignored by the default profile.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
AI_RAG_ENABLED=true
EMBEDDING_PROVIDER=ollama
# Optional separate origin for embedding outage tests; defaults to OLLAMA_BASE_URL.
# EMBEDDING_BASE_URL=http://localhost:11434
# Legacy vector rollback only; require a fresh probe for another model.
# EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_INDEX_REVISION=m5.v1
KNOWLEDGE_STORAGE_ROOT=storage/knowledge
KNOWLEDGE_JOB_TIMEOUT_MS=600000
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.50
RAG_CONTEXT_CHARS=6000
HEALTH_TIMEOUT_MS=2000
# M22 operational alerts use canonical M12 SLA; these never mutate business decisions.
SLA_ALERT_ENABLED=true
SLA_ALERT_EARLY_RATIO=0.5
SLA_ALERT_AT_RISK_ENABLED=true
SLA_ALERT_BREACH_ENABLED=true
# Cadence 30–3600 seconds; batch 1–200; bounded sweep budget 1000–30000 ms.
SLA_ALERT_INTERVAL_SECONDS=60
SLA_ALERT_BATCH_SIZE=100
SLA_ALERT_TIME_BUDGET_MS=10000
